# Copy to .env and adjust. Every value has a default in docker-compose.yml.

# Project name: prefixes containers, image, network (e.g. flood-alert-app)
PROJECT_NAME=laravel

# Path to the Laravel app to run (relative to this folder or absolute)
APP_PATH=../app

# Match your host user so files created inside the container are owned by you
HOST_UID=1000
HOST_GID=1000

# Host ports
APP_PORT=3000
DB_PORT=3001
REDIS_PORT=3002
REVERB_PORT=3003

# Database credentials (keep in sync with the app's .env)
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel
